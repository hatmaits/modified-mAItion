@@ -22,8 +22,10 @@ class EnvSettings(BaseSettings):
     POSTGRES_PORT: int
     DATABASE_URL: str
 
-    OPENROUTER_API_KEY: str
-    OPENROUTER_API_BASE: str
+    OPENROUTER_API_KEY: str = ""
+    OPENROUTER_API_BASE: str = "https://openrouter.ai/api/v1"
+    OLLAMA_API_KEY: str = "ollama"
+    OLLAMA_API_BASE: str = "http://ollama:11434/v1"
     API_KEY: str = ""
     MCP_ENABLE: bool = False
     MCP_API_KEY: str = ""
@@ -148,13 +150,34 @@ class Settings:
         return sources
 
     @property
-    def LLM(self):
+    def OPENAI_COMPATIBLE(self):
         return {
             "api_key": self.env.OPENROUTER_API_KEY,
             "base_url": self.env.OPENROUTER_API_BASE,
-            "provider": self.yaml.get("inference", {}).get("provider"),
-            "llm_model": self.yaml.get("inference", {}).get("model_config"),
         }
 
+    @property
+    def OLLAMA(self):
+        base_url = self.env.OLLAMA_API_BASE.rstrip("/")
+        if not base_url.endswith("/v1"):
+            base_url = f"{base_url}/v1"
+        return {
+            # Ollama ignores this local compatibility key, while the OpenAI
+            # client requires a non-empty value.
+            "api_key": self.env.OLLAMA_API_KEY.strip() or "ollama",
+            "base_url": base_url,
+        }
+
+    @property
+    def LLM(self):
+        provider = self.yaml.get("inference", {}).get("provider")
+        provider = provider.lower() if isinstance(provider, str) else provider
+        connection = self.OLLAMA if provider == "ollama" else self.OPENAI_COMPATIBLE
+        return {
+            **connection,
+            "provider": provider,
+            "llm_model": self.yaml.get("inference", {}).get("model_config"),
+        }
+
 
 settings = Settings()

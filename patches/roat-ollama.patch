+        api_base=settings.OPENAI_COMPATIBLE["base_url"],
         model_name=settings.EMBEDDING["model_config"],
     )
+else:
+    raise ValueError(
+        f"Unsupported embedding provider: {settings.EMBEDDING.get('provider')}. "
+        "Expected one of: local, ollama, openai, openrouter."
+    )
 
 # Initialize LLM
 llm = None
 if llm_provider in ("openai", "openrouter"):
     llm = OpenRouter(
         api_key=settings.LLM.get("api_key"), model=settings.LLM.get("llm_model"), api_base=settings.LLM["base_url"]
     )
+elif llm_provider == "ollama":
+    # Ollama exposes an OpenAI-compatible API at /v1. Reusing the pinned
+    # OpenAI-like adapter keeps the derived image small while making Ollama a
+    # first-class provider in config.yaml.
+    llm = OpenRouter(
+        api_key=settings.OLLAMA["api_key"],
+        model=settings.LLM.get("llm_model"),
+        api_base=settings.OLLAMA["base_url"],
+    )
+elif llm_provider not in (None, "", "none"):
+    raise ValueError(
+        f"Unsupported inference provider: {settings.LLM.get('provider')}. "
+        "Expected one of: ollama, openai, openrouter, none."
+    )
 
 __all__ = ["embed_model", "llm"]
